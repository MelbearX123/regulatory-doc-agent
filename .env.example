# Copy to .env and fill in. Never commit .env.

# Browser: set to false to watch Chromium while debugging
HEADLESS=true

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Pretty logs for local dev (needs dev dependencies); leave unset in production for JSON lines
LOG_PRETTY=true

# Gmail account the agent reads from and replies with (needs 2FA + an app password)
GMAIL_ADDRESS=your-agent@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# IMAP_HOST=imap.gmail.com
# SMTP_HOST=smtp.gmail.com
# New mail is pushed instantly (IMAP IDLE); this backup check catches anything missed
MAIL_SWEEP_INTERVAL_MS=300000

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5
